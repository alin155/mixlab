{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixLab Smart Cutter",
  "version": "0.1.0",
  "identifier": "com.mixlab.smartcutter",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev:smart-cutter-web",
    "beforeBuildCommand": "npm --prefix ../.. run build:smart-cutter-web",
    "devUrl": "http://127.0.0.1:5178",
    "frontendDist": "../../smart-cutter-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "MixLab 智能剪辑端", "width": 1440, "height": 900, "minWidth": 1180, "minHeight": 720 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MixLab",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["binaries/", "runtime/"],
    "windows": { "nsis": { "displayLanguageSelector": false, "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico" } }
  }
}
